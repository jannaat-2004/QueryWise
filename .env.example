# ============================================================================
# QUERYWISE - PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env for local development, or configure these variables
# in your Vercel Project Settings -> Environment Variables.
# NEVER commit your actual .env file or real API keys to GitHub.
# ============================================================================

# 1. GOOGLE GEMINI API KEY (REQUIRED - Backend / Vercel Serverless Function)
# Used by the backend (/api/chat/process, /api/chat/interpret, /api/sql/*)
# to generate and interpret SQL queries using Google Gemini.
# Never prefix this variable with VITE_ so it stays strictly server-side.
GEMINI_API_KEY="your_google_gemini_api_key_here"

# 2. AUTHENTICATION SIGNING SECRET (RECOMMENDED - Backend / Vercel Serverless)
# Used to sign stateless HMAC-SHA256 session tokens across serverless instances.
AUTH_SECRET="replace_with_a_random_32_char_secret_string"

# 3. EXTERNAL BACKEND API URL (OPTIONAL - Frontend Vite Build)
# Leave empty when deploying both Frontend + /api/* Serverless Functions together on Vercel.
# Set to your external backend URL (e.g. "https://querywise-api.onrender.com") ONLY if hosting
# the Express backend on a separate service such as Render or Railway.
VITE_API_BASE_URL=""

# 4. ALLOWED CORS ORIGIN (OPTIONAL - Backend)
# Defaults to reflecting the request origin or "*". Set to your Vercel frontend domain
# (e.g. "https://querywise.vercel.app") if hosting the backend on a separate service.
CORS_ORIGIN=""

# 5. SUPABASE CLOUD PERSISTENCE (OPTIONAL - Frontend & Backend)
# QueryWise includes built-in SQLite + IndexedDB + HMAC-signed auth persistence out of the box.
# Optionally provide Supabase credentials for cross-device cloud sync:
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
